rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la colección de salud de alumnos
    match /artifacts/{appId}/public/data/students/{studentId} {
      // Solo usuarios autenticados (PIN de centro o Google) pueden leer
      allow read: if request.auth != null;
      // Solo usuarios autenticados pueden escribir
      allow write: if request.auth != null;
    }

    // Reglas para la colección de auditoría y registros
    match /artifacts/{appId}/public/data/logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }

    // Denegar cualquier otra ruta no autorizada por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
